# FMCG AI Sales Assistant — Environment Variables
# Copy this file to .env and fill in your values.

# Gemini API key (required for Text-to-SQL and answer generation)
LLM_API_KEY=

# Gemini model to use
LLM_MODEL=gemini-2.0-flash

# Path to the SQLite database file
DB_PATH=backend/data/fmcg.db

# Maximum number of rows returned per query
MAX_QUERY_ROWS=1000

# LLM retry configuration
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY_SECONDS=1.5
